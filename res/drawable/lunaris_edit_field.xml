<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetTop="4dp"
    android:insetBottom="4dp">
    <selector>
        <item android:state_focused="true">
            <shape android:shape="rectangle">
                <solid android:color="@color/lunaris_surface_container" />
                <stroke
                    android:width="2dp"
                    android:color="@color/lunaris_primary" />
                <corners android:radius="16dp" />
                <padding
                    android:bottom="14dp"
                    android:left="16dp"
                    android:right="16dp"
                    android:top="14dp" />
            </shape>
        </item>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="@color/lunaris_surface_container" />
                <corners android:radius="16dp" />
                <padding
                    android:bottom="14dp"
                    android:left="16dp"
                    android:right="16dp"
                    android:top="14dp" />
            </shape>
        </item>
    </selector>
</inset>
