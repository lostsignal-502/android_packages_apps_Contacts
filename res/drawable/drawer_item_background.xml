<!-- Pill shaped navigation drawer item, as in Material 3 Expressive navigation drawers. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/m3e_drawer_item_inset"
    android:insetRight="@dimen/m3e_drawer_item_inset">
    <ripple android:color="@color/control_highlight_color">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <corners android:radius="@dimen/m3e_corner_full" />
            </shape>
        </item>
        <item>
            <selector>
                <item android:state_activated="true">
                    <shape android:shape="rectangle">
                        <solid android:color="@color/drawer_selected_color" />
                        <corners android:radius="@dimen/m3e_corner_full" />
                    </shape>
                </item>
                <item android:drawable="@android:color/transparent" />
            </selector>
        </item>
    </ripple>
</inset>
