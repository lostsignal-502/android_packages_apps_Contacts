<!-- Rounded, inset press feedback for list rows. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="@dimen/m3e_list_item_inset"
    android:insetRight="@dimen/m3e_list_item_inset">
    <ripple android:color="@color/control_highlight_color">
        <item android:id="@android:id/mask">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/white" />
                <corners android:radius="@dimen/m3e_corner_large" />
            </shape>
        </item>
    </ripple>
</inset>
