<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickcontact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <ScrollView
        android:id="@+id/content_scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="?android:attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Expressive hero card holding the contact photo. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/m3e_quickcontact_hero_height"
                android:layout_marginStart="@dimen/m3e_page_margin"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="@dimen/m3e_page_margin"
                android:background="@drawable/m3e_quickcontact_hero"
                android:clipToOutline="true">

                <com.android.contacts.widget.QuickContactImageView
                    android:id="@+id/photo"
                    android:layout_width="@dimen/m3e_quickcontact_photo_size"
                    android:layout_height="@dimen/m3e_quickcontact_photo_size"
                    android:layout_gravity="center"
                    android:scaleType="centerCrop" />
            </FrameLayout>

            <TextView
                android:id="@+id/large_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/m3e_header_margin"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="@dimen/m3e_header_margin"
                android:ellipsize="end"
                android:fontFamily="@*android:string/config_headlineFontFamily"
                android:maxLines="2"
                android:textColor="@color/m3e_on_surface"
                android:textSize="@dimen/m3e_quickcontact_name_size" />

            <TextView
                android:id="@+id/phonetic_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/m3e_header_margin"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="@dimen/m3e_header_margin"
                android:textColor="@color/m3e_on_surface_variant"
                android:textSize="@dimen/m3e_text_title_large"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/quick_action_call"
                    layout="@layout/m3e_quick_action" />

                <include
                    android:id="@+id/quick_action_message"
                    layout="@layout/m3e_quick_action" />

                <include
                    android:id="@+id/quick_action_video"
                    layout="@layout/m3e_quick_action" />

                <include
                    android:id="@+id/quick_action_email"
                    layout="@layout/m3e_quick_action" />
            </LinearLayout>

            <include layout="@layout/quickcontact_content" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/toolbar_parent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/background_primary">

        <ImageButton
            android:id="@+id/quickcontact_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="12dp"
            android:background="@drawable/m3e_round_button"
            android:contentDescription="@string/back_arrow_content_description"
            android:src="@drawable/quantum_ic_arrow_back_vd_theme_24"
            android:tint="@color/actionbar_icon_color" />

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_gravity="end|bottom"
            android:paddingEnd="12dp" />
    </FrameLayout>
</FrameLayout>
