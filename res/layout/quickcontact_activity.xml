<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickcontact_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <ScrollView
        android:id="@+id/content_scroller"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingTop="?android:attr/actionBarSize">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <com.android.contacts.widget.QuickContactImageView
                android:id="@+id/photo"
                android:layout_width="@dimen/lunaris_quickcontact_photo_size"
                android:layout_height="@dimen/lunaris_quickcontact_photo_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/large_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lunaris_header_margin"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/lunaris_header_margin"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/lunaris_on_surface"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/phonetic_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lunaris_header_margin"
                android:layout_marginEnd="@dimen/lunaris_header_margin"
                android:gravity="center"
                android:textColor="@color/lunaris_on_surface_variant"
                android:textSize="16sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/quick_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="12dp"
                android:layout_marginBottom="16dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/quick_action_call"
                    layout="@layout/lunaris_quick_action" />

                <include
                    android:id="@+id/quick_action_message"
                    layout="@layout/lunaris_quick_action" />

                <include
                    android:id="@+id/quick_action_video"
                    layout="@layout/lunaris_quick_action" />

                <include
                    android:id="@+id/quick_action_email"
                    layout="@layout/lunaris_quick_action" />
            </LinearLayout>

            <include layout="@layout/quickcontact_content" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/toolbar_parent"
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:background="@color/background_primary">

        <ImageButton
            android:id="@+id/quickcontact_back"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="start|bottom"
            android:layout_marginStart="12dp"
            android:background="@drawable/lunaris_round_button"
            android:contentDescription="@string/back_arrow_content_description"
            android:src="@drawable/quantum_ic_arrow_back_vd_theme_24"
            android:tint="@color/actionbar_icon_color" />

        <Toolbar
            android:id="@+id/toolbar"
            android:layout_width="wrap_content"
            android:layout_height="?android:attr/actionBarSize"
            android:layout_gravity="end|bottom"
            android:paddingEnd="12dp" />
    </FrameLayout>
</FrameLayout>
